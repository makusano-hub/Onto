    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Calle_Bories -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Calle_Bories">
        <rdf:type rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#ZonaTiendas"/>
        <Ontologia2:ubicadoEnCiudad rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Punta_Arenas"/>
        <Ontologia2:Descripcion>Calle considerada como el centro de Punta Arenas con muchos negocios de distinta indole</Ontologia2:Descripcion>
        <Ontologia2:requierePermisoAutoridad rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Ontologia2:requierePermisoAutoridad>
        <Ontologia2:tieneTemporada rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Ontologia2:tieneTemporada>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Cementerio_Sara_Braun -->

