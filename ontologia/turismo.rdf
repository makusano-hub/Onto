        <rdfs:label xml:lang="es">Ciudad</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Comida -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Comida">
