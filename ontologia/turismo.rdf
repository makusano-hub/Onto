    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Hotel -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Hotel">
