        <rdfs:subClassOf rdf:resource="https://schema.org/Mountain"/>
        <rdfs:label xml:lang="es">Montaña</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Museo -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Museo">
