        <rdf:type rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#SitioHistorico"/>
        <Ontologia2:ubicadoEnCiudad rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Punta_Arenas"/>
        <Ontologia2:Nombre>Cementerio Municipal Sara Braun</Ontologia2:Nombre>
        <Ontologia2:tieneModelo3D rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">modelos3d/fachadaCementerio.fbx</Ontologia2:tieneModelo3D>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Circuito_O -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Circuito_O">
        <rdf:type rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Senderismo"/>
        <Ontologia2:seRealizaEn rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#ParqueTorresDelPaine"/>
        <Ontologia2:Descripcion>• Duración: 8 a 9 días (7 a 8 noches).
• Distancia: Entre 93 y 110 kilómetros.
• Dificultad: Alta y extenuante</Ontologia2:Descripcion>
        <Ontologia2:Nombre>Circuito O de senderismo</Ontologia2:Nombre>
        <Ontologia2:requierePermisoAutoridad rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Ontologia2:requierePermisoAutoridad>
        <Ontologia2:tieneTemporada rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Ontologia2:tieneTemporada>
    </owl:NamedIndividual>
    


