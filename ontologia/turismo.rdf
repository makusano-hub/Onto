        <rdfs:subClassOf rdf:resource="https://schema.org/Hotel"/>
        <rdfs:label xml:lang="es">Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Lago -->

