        <rdfs:label xml:lang="es">Comuna</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Cotidiana -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Cotidiana">
