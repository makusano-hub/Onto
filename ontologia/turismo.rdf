    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#permiteActividad -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#permiteActividad">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#seRealizaEn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Lugares"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Actividad"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#perteneceAComuna -->

