        <rdfs:label xml:lang="es">Compras</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Comuna -->

    <owl:Class rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Comuna">
