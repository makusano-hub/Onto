<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2/"
     xml:base="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:Ontologia2="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2">
        <rdfs:comment xml:lang="es">Lugares, actividades, ciudades y comunas de la Región de Magallanes y de la Antártica Chilena, con sus modelos 3D.</rdfs:comment>
        <rdfs:label xml:lang="es">Ontología de turismo de la Región de Magallanes</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#permiteActividad -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#permiteActividad">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#seRealizaEn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Lugares"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Actividad"/>
        <rdfs:comment xml:lang="es">Actividad que se puede realizar en el lugar. Es la inversa de seRealizaEn.</rdfs:comment>
        <rdfs:label xml:lang="es">permite actividad</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#perteneceAComuna -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#perteneceAComuna">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/containedInPlace"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Ciudad"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Comuna"/>
        <rdfs:comment xml:lang="es">Comuna a la que pertenece una ciudad.</rdfs:comment>
        <rdfs:label xml:lang="es">pertenece a comuna</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#seRealizaEn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#seRealizaEn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Actividad"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Lugares"/>
        <rdfs:comment xml:lang="es">Lugar donde se realiza una actividad.</rdfs:comment>
        <rdfs:label xml:lang="es">se realiza en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#ubicadoEnCiudad -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#ubicadoEnCiudad">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/containedInPlace"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Lugares"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Ciudad"/>
        <rdfs:comment xml:lang="es">Ciudad donde está el lugar.</rdfs:comment>
        <rdfs:label xml:lang="es">ubicado en ciudad</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#ubicadoEnComuna -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#ubicadoEnComuna">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/containedInPlace"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Lugares"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Comuna"/>
        <rdfs:comment xml:lang="es">Comuna donde está el lugar.</rdfs:comment>
        <rdfs:label xml:lang="es">ubicado en comuna</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/containedInPlace -->

    <owl:ObjectProperty rdf:about="https://schema.org/containedInPlace"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Calificacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Calificacion">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Calificación de 0 a 5.</rdfs:comment>
        <rdfs:label xml:lang="es">calificación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Descripcion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Descripcion">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/description"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Texto que describe el lugar o la actividad.</rdfs:comment>
        <rdfs:label xml:lang="es">descripción</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Latitud -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Latitud">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/latitude"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Latitud en grados decimales (WGS 84); negativa en el hemisferio sur.</rdfs:comment>
        <rdfs:label xml:lang="es">latitud</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Longitud -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Longitud">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/longitude"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Longitud en grados decimales (WGS 84); negativa al oeste de Greenwich.</rdfs:comment>
        <rdfs:label xml:lang="es">longitud</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Nombre -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Nombre">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Nombre con el que se muestra al público.</rdfs:comment>
        <rdfs:label xml:lang="es">nombre</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Precio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Precio">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Precio en pesos chilenos; 0 significa gratis.</rdfs:comment>
        <rdfs:label xml:lang="es">precio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#requierePermisoAutoridad -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#requierePermisoAutoridad">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Verdadero si se necesita permiso de una autoridad.</rdfs:comment>
        <rdfs:label xml:lang="es">requiere permiso de la autoridad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#tieneEnlace -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#tieneEnlace">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="es">Dirección web con más información. Puede repetirse.</rdfs:comment>
        <rdfs:label xml:lang="es">tiene enlace</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#tieneImagen -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#tieneImagen">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="es">Ruta dentro de public/ o dirección web de una imagen. Puede repetirse.</rdfs:comment>
        <rdfs:label xml:lang="es">tiene imagen</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#tieneModelo3D -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#tieneModelo3D">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#Lugares"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="es">Ruta dentro de public/ o dirección web de un modelo 3D (.glb o .gltf). Puede repetirse.</rdfs:comment>
        <rdfs:label xml:lang="es">tiene modelo 3D</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#tieneTemporada -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/usuario/ontologies/2026/9/Ontologia2#tieneTemporada">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Verdadero si depende de la temporada; falso si está disponible todo el año.</rdfs:comment>
        <rdfs:label xml:lang="es">tiene temporada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/description -->

    <owl:DatatypeProperty rdf:about="https://schema.org/description"/>
    


    <!-- https://schema.org/image -->

    <owl:DatatypeProperty rdf:about="https://schema.org/image"/>
    


    <!-- https://schema.org/latitude -->

    <owl:DatatypeProperty rdf:about="https://schema.org/latitude"/>
    


    <!-- https://schema.org/longitude -->

    <owl:DatatypeProperty rdf:about="https://schema.org/longitude"/>
    


    <!-- https://schema.org/name -->

    <owl:DatatypeProperty rdf:about="https://schema.org/name"/>
    


