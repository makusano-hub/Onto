<?xml version="1.0"?>
<rdf:RDF xmlns="https://makusano-hub.github.io/Onto/ontologia/"
     xml:base="https://makusano-hub.github.io/Onto/ontologia/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:Ontologia2="https://makusano-hub.github.io/Onto/ontologia#">
    <owl:Ontology rdf:about="https://makusano-hub.github.io/Onto/ontologia">
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-26</dcterms:created>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-20</dcterms:modified>
        <owl:versionInfo>1.1.0</owl:versionInfo>
        <rdfs:comment xml:lang="es">Lugares, actividades, ciudades y comunas de la Región de Magallanes y de la Antártica Chilena, con sus modelos 3D.</rdfs:comment>
        <rdfs:label xml:lang="es">Ontología de turismo de la Región de Magallanes</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://makusano-hub.github.io/Onto/ontologia#permiteActividad -->

    <owl:ObjectProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#permiteActividad">
        <owl:inverseOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#seRealizaEn"/>
        <rdfs:domain rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:range rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Actividad"/>
        <rdfs:comment xml:lang="es">Actividad que se puede realizar en el lugar. Es la inversa de seRealizaEn.</rdfs:comment>
        <rdfs:label xml:lang="es">permite actividad</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#perteneceAComuna -->

    <owl:ObjectProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#perteneceAComuna">
        <rdfs:subPropertyOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#ubicadoEn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/containedInPlace"/>
        <rdfs:domain rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Ciudad"/>
        <rdfs:range rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Comuna"/>
        <rdfs:comment xml:lang="es">Comuna a la que pertenece una ciudad. Una ciudad pertenece a una sola comuna.</rdfs:comment>
        <rdfs:label xml:lang="es">pertenece a comuna</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#seRealizaEn -->

    <owl:ObjectProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#seRealizaEn">
        <rdfs:domain rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Actividad"/>
        <rdfs:range rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:comment xml:lang="es">Lugar donde se realiza una actividad.</rdfs:comment>
        <rdfs:label xml:lang="es">se realiza en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#ubicadoEn -->

    <owl:ObjectProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#ubicadoEn">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/containedInPlace"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="es">Lugar mayor que contiene a este: la ciudad o la comuna de un lugar, o la comuna de una ciudad. Es transitiva: un lugar ubicado en una ciudad está también en la comuna de esa ciudad.</rdfs:comment>
        <rdfs:label xml:lang="es">ubicado en</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://makusano-hub.github.io/Onto/ontologia#ubicadoEnCiudad -->

    <owl:ObjectProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#ubicadoEnCiudad">
        <rdfs:subPropertyOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#ubicadoEn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/containedInPlace"/>
        <rdfs:domain rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:range rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Ciudad"/>
        <rdfs:comment xml:lang="es">Ciudad donde está el lugar. Un lugar está en una sola ciudad.</rdfs:comment>
        <rdfs:label xml:lang="es">ubicado en ciudad</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#ubicadoEnComuna -->

    <owl:ObjectProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#ubicadoEnComuna">
        <rdfs:subPropertyOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#ubicadoEn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/containedInPlace"/>
        <rdfs:domain rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:range rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Comuna"/>
        <rdfs:comment xml:lang="es">Comuna donde está el lugar. Un lugar está en una sola comuna.</rdfs:comment>
        <rdfs:label xml:lang="es">ubicado en comuna</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/containedInPlace -->

    <owl:ObjectProperty rdf:about="https://schema.org/containedInPlace"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Calificacion -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#Calificacion">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Actividad"/>
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Calificación de 0 a 5.</rdfs:comment>
        <rdfs:label xml:lang="es">calificación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Descripcion -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#Descripcion">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/description"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="es">Texto que describe el lugar o la actividad. Lleva su idioma (xml:lang).</rdfs:comment>
        <rdfs:label xml:lang="es">descripción</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Latitud -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#Latitud">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Ciudad"/>
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Comuna"/>
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/latitude"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Latitud en grados decimales (WGS 84); negativa en el hemisferio sur.</rdfs:comment>
        <rdfs:label xml:lang="es">latitud</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Longitud -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#Longitud">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Ciudad"/>
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Comuna"/>
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:subPropertyOf rdf:resource="https://schema.org/longitude"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Longitud en grados decimales (WGS 84); negativa al oeste de Greenwich.</rdfs:comment>
        <rdfs:label xml:lang="es">longitud</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Nombre -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#Nombre">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/name"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="es">Nombre con el que se muestra al público. Lleva su idioma (xml:lang).</rdfs:comment>
        <rdfs:label xml:lang="es">nombre</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Precio -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#Precio">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Actividad"/>
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Precio en pesos chilenos; 0 significa gratis.</rdfs:comment>
        <rdfs:label xml:lang="es">precio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#requierePermisoAutoridad -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#requierePermisoAutoridad">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Actividad"/>
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Verdadero si se necesita permiso de una autoridad.</rdfs:comment>
        <rdfs:label xml:lang="es">requiere permiso de la autoridad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#tieneEnlace -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#tieneEnlace">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="es">Dirección web con más información. Puede repetirse.</rdfs:comment>
        <rdfs:label xml:lang="es">tiene enlace</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#tieneImagen -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#tieneImagen">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="es">Ruta dentro de public/ o dirección web de una imagen. Puede repetirse.</rdfs:comment>
        <rdfs:label xml:lang="es">tiene imagen</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#tieneModelo3D -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#tieneModelo3D">
        <rdfs:domain rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="es">Ruta dentro de public/ o dirección web de un modelo 3D (.glb o .gltf). Puede repetirse.</rdfs:comment>
        <rdfs:label xml:lang="es">tiene modelo 3D</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://makusano-hub.github.io/Onto/ontologia#tieneTemporada -->

    <owl:DatatypeProperty rdf:about="https://makusano-hub.github.io/Onto/ontologia#tieneTemporada">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Actividad"/>
                    <rdf:Description rdf:about="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Verdadero si depende de la temporada; falso si está disponible todo el año.</rdfs:comment>
        <rdfs:label xml:lang="es">tiene temporada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/description -->

    <owl:DatatypeProperty rdf:about="https://schema.org/description"/>
    


    <!-- https://schema.org/image -->

    <owl:DatatypeProperty rdf:about="https://schema.org/image"/>
    


    <!-- https://schema.org/latitude -->

    <owl:DatatypeProperty rdf:about="https://schema.org/latitude"/>
    


    <!-- https://schema.org/longitude -->

    <owl:DatatypeProperty rdf:about="https://schema.org/longitude"/>
    


    <!-- https://schema.org/name -->

    <owl:DatatypeProperty rdf:about="https://schema.org/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Actividad -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Actividad">
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Ciudad"/>
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Comuna"/>
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://makusano-hub.github.io/Onto/ontologia#seRealizaEn"/>
                <owl:someValuesFrom rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="es">Actividad</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Alojamiento -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Alojamiento">
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Cotidiana"/>
        <rdfs:label xml:lang="es">Alojamiento</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Cafeteria -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Cafeteria">
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Establecimientos"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/CafeOrCoffeeShop"/>
        <rdfs:label xml:lang="es">Cafetería</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Ciudad -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Ciudad">
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Comuna"/>
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://makusano-hub.github.io/Onto/ontologia#perteneceAComuna"/>
                <owl:someValuesFrom rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Comuna"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:resource="https://schema.org/City"/>
        <rdfs:label xml:lang="es">Ciudad</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Comida -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Comida">
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Cotidiana"/>
        <rdfs:label xml:lang="es">Comida</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Compras -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Compras">
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Cotidiana"/>
        <rdfs:label xml:lang="es">Compras</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Comuna -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Comuna">
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/AdministrativeArea"/>
        <rdfs:label xml:lang="es">Comuna</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Cotidiana -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Cotidiana">
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Turistica"/>
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Actividad"/>
        <rdfs:label xml:lang="es">Actividad cotidiana</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#CulturalHistorico -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#CulturalHistorico">
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/TouristAttraction"/>
        <rdfs:label xml:lang="es">Cultural e histórico</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Establecimientos -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Establecimientos">
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Naturaleza"/>
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Lugares"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/LocalBusiness"/>
        <rdfs:label xml:lang="es">Establecimiento</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Estatua -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Estatua">
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#CulturalHistorico"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/LandmarksOrHistoricalBuildings"/>
        <rdfs:label xml:lang="es">Monumento</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Hotel -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Hotel">
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Establecimientos"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Hotel"/>
        <rdfs:label xml:lang="es">Hotel</rdfs:label>
    </owl:Class>
    


    <!-- https://makusano-hub.github.io/Onto/ontologia#Lago -->

    <owl:Class rdf:about="https://makusano-hub.github.io/Onto/ontologia#Lago">
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Montaña"/>
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Parque"/>
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Reserva"/>
        <owl:disjointWith rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Rio"/>
        <rdfs:subClassOf rdf:resource="https://makusano-hub.github.io/Onto/ontologia#Naturaleza"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/LakeBodyOfWater"/>
        <rdfs:label xml:lang="es">Lago</rdfs:label>
