# Reglas de validación de la ontología de turismo, en SHACL.
#
# Son las reglas de integridad que antes solo existían en js/validacion.js:
# aquí están como datos, y cualquier herramienta SHACL puede aplicarlas.
#
#   Con Fuseki en marcha:  pestaña Validación del panel (bloque "Reglas SHACL")
#   Sin Fuseki:            java -cp C:\apache-jena-fuseki-6.2.0\fuseki-server.jar shacl.shacl validate ^
#                            --shapes ontologia/turismo.shacl.ttl --data ontologia/turismo.rdf
#
# sh:Violation = error que hay que corregir. sh:Warning = aviso.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix t:    <https://makusano-hub.github.io/Onto/ontologia#> .
# El espacio de nombres de las formas es este mismo archivo, tal como se publica
@prefix f:    <https://makusano-hub.github.io/Onto/datos/turismo.shacl.ttl#> .

# ---------- Identificadores

f:Individuo
    a sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https://makusano-hub\\.github\\.io/Onto/ontologia#[\\p{L}\\p{N}_-]+$" ;
    sh:message "El IRI debe estar en el espacio de nombres de la ontología y usar solo letras, números, _ y -: si no, atraccion.html no puede abrirlo."@es .

# ---------- Datos de lugares y actividades (lo que el sitio muestra como atracción)

f:Atraccion
    a sh:NodeShape ;
    sh:targetClass t:Lugares , t:Actividad ;
    sh:property [
        sh:path t:Nombre ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Sin t:Nombre: el sitio muestra un nombre generado desde el IRI."@es
    ] ;
    sh:property [
        sh:path t:Nombre ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
        sh:message "Tiene más de un t:Nombre; la interfaz muestra solo uno."@es
    ] ;
    # Los textos para personas llevan su idioma: así quien reutiliza los datos sabe en qué lengua están
    sh:property [
        sh:path t:Nombre ;
        sh:datatype rdf:langString ;
        sh:severity sh:Warning ;
        sh:message "t:Nombre sin idioma: escríbelo con su lengua, por ejemplo \"Fuerte Bulnes\"@es."@es
    ] ;
    sh:property [
        sh:path t:Descripcion ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
        sh:message "Tiene más de una t:Descripcion; la interfaz muestra solo una."@es
    ] ;
    sh:property [
        sh:path t:Descripcion ;
        sh:datatype rdf:langString ;
        sh:severity sh:Warning ;
        sh:message "t:Descripcion sin idioma: escríbela con su lengua, por ejemplo \"…\"@es."@es
    ] ;
    sh:property [
        sh:path t:Calificacion ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 5 ;
        sh:message "t:Calificacion debe ser un xsd:decimal entre 0 y 5."@es
    ] ;
    sh:property [
        sh:path t:Calificacion ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Tiene más de una t:Calificacion."@es
    ] ;
    sh:property [
        sh:path t:Precio ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:message "t:Precio debe ser un único xsd:integer sin signo (pesos chilenos; 0 es gratis)."@es
    ] ;
    sh:property [
        sh:path t:requierePermisoAutoridad ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "t:requierePermisoAutoridad debe ser un único xsd:boolean."@es
    ] ;
    sh:property [
        sh:path t:tieneTemporada ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "t:tieneTemporada debe ser un único xsd:boolean."@es
    ] ;
    sh:property [
        sh:path t:tieneModelo3D ;
        sh:datatype xsd:anyURI ;
        sh:pattern "\\.(glb|gltf)(\\?.*)?$" ;
        sh:flags "i" ;
        sh:message "t:tieneModelo3D debe ser un xsd:anyURI que termine en .glb o .gltf: el visor no abre otros formatos."@es
    ] ;
    sh:property [
        sh:path t:tieneImagen ;
        sh:datatype xsd:anyURI ;
        sh:message "t:tieneImagen debe ser un xsd:anyURI."@es
    ] .

# Los enlaces se validan en cualquier individuo que los tenga: las ciudades también llevan el de Wikipedia
f:Enlace
    a sh:NodeShape ;
    sh:targetSubjectsOf t:tieneEnlace ;
    sh:property [
        sh:path t:tieneEnlace ;
        sh:datatype xsd:anyURI ;
        sh:pattern "^https?://[^\\s/]+\\.[^\\s]+$" ;
        sh:message "t:tieneEnlace debe ser un xsd:anyURI con una dirección http(s) completa."@es
    ] .

# ---------- Relaciones de los lugares

f:Lugar
    a sh:NodeShape ;
    sh:targetClass t:Lugares ;
    # La comuna se indica directamente o a través de la ciudad
    sh:property [
        sh:path [ sh:alternativePath ( t:ubicadoEnComuna ( t:ubicadoEnCiudad t:perteneceAComuna ) ) ] ;
        sh:minCount 1 ;
        sh:message "Sin comuna: no aparece al filtrar por comuna. Añade t:ubicadoEnComuna, o t:ubicadoEnCiudad hacia una ciudad con comuna."@es
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( t:ubicadoEnComuna ( t:ubicadoEnCiudad t:perteneceAComuna ) ) ] ;
        sh:maxCount 1 ;
        sh:message "Tiene más de una comuna: t:ubicadoEnComuna no coincide con la comuna de su ciudad."@es
    ] ;
    sh:property [
        sh:path t:ubicadoEnCiudad ;
        sh:class t:Ciudad ;
        sh:message "t:ubicadoEnCiudad debe apuntar a un individuo de tipo t:Ciudad."@es
    ] ;
    sh:property [
        sh:path t:ubicadoEnComuna ;
        sh:class t:Comuna ;
        sh:message "t:ubicadoEnComuna debe apuntar a un individuo de tipo t:Comuna."@es
    ] ;
    sh:property [
        sh:path t:permiteActividad ;
        sh:class t:Actividad ;
        sh:message "t:permiteActividad debe apuntar a una actividad."@es
    ] .

# ---------- Relaciones de las actividades

f:Actividad
    a sh:NodeShape ;
    sh:targetClass t:Actividad ;
    # Una actividad se ubica a través del lugar donde se realiza
    sh:property [
        sh:path [ sh:alternativePath ( t:seRealizaEn [ sh:inversePath t:permiteActividad ] ) ] ;
        sh:minCount 1 ;
        sh:message "Es una actividad sin lugar: no tiene comuna ni ciudad. Añade t:seRealizaEn hacia el lugar donde se realiza."@es
    ] ;
    sh:property [
        sh:path t:seRealizaEn ;
        sh:class t:Lugares ;
        sh:message "t:seRealizaEn debe apuntar a un lugar."@es
    ] .

# ---------- Ciudades

f:Ciudad
    a sh:NodeShape ;
    sh:targetClass t:Ciudad ;
    sh:property [
        sh:path t:perteneceAComuna ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class t:Comuna ;
        sh:message "Una ciudad debe tener exactamente un t:perteneceAComuna hacia una t:Comuna: sin él, sus atracciones quedan sin comuna."@es
    ] .

# ---------- Comunas y provincias

f:Comuna
    a sh:NodeShape ;
    sh:targetClass t:Comuna ;
    sh:property [
        sh:path t:ubicadoEnProvincia ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Sin t:ubicadoEnProvincia: no se sabe en qué provincia está la comuna, ni por inferencia sus ciudades y lugares."@es
    ] ;
    sh:property [
        sh:path t:ubicadoEnProvincia ;
        sh:class t:Provincias ;
        sh:message "t:ubicadoEnProvincia debe apuntar a un individuo de tipo t:Provincias."@es
    ] .

# La capital va de la ciudad a la provincia; que quien la usa sea una ciudad lo comprueba f:Dominio
f:Capital
    a sh:NodeShape ;
    sh:targetSubjectsOf t:esCapitalProvincial ;
    sh:property [
        sh:path t:esCapitalProvincial ;
        sh:class t:Provincias ;
        sh:message "t:esCapitalProvincial va de una ciudad a su provincia: debe apuntar a un individuo de tipo t:Provincias."@es
    ] .

# ---------- Coordenadas

f:Coordenadas
    a sh:NodeShape ;
    sh:targetSubjectsOf t:Latitud , t:Longitud ;
    sh:property [
        sh:path t:Latitud ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:message "Las coordenadas van en pareja: un único t:Latitud xsd:decimal entre -90 y 90."@es
    ] ;
    sh:property [
        sh:path t:Longitud ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:message "Las coordenadas van en pareja: un único t:Longitud xsd:decimal entre -180 y 180."@es
    ] ;
    # Límites de la carta 3D (js/region-geo.js): detecta latitud y longitud intercambiadas
    sh:property [
        sh:path t:Latitud ;
        sh:minInclusive -56.6 ;
        sh:maxInclusive -48.6 ;
        sh:severity sh:Warning ;
        sh:message "La latitud queda fuera de la carta de la región (entre -56,6 y -48,6)."@es
    ] ;
    sh:property [
        sh:path t:Longitud ;
        sh:minInclusive -76 ;
        sh:maxInclusive -66.4 ;
        sh:severity sh:Warning ;
        sh:message "La longitud queda fuera de la carta de la región (entre -76 y -66,4)."@es
    ] .

# ---------- Coherencia con los axiomas de la ontología
#
# Estas tres reglas leen los axiomas del propio grafo (owl:disjointWith, owl:FunctionalProperty y rdfs:domain)
# y comprueban que los datos no los contradicen: si la ontología gana un axioma, la regla lo aplica sin tocarla.
# No sustituyen a un razonador como HermiT (no deducen nada nuevo ni prueban la consistencia completa), pero
# detienen el despliegue ante las contradicciones que esos axiomas hacen posibles.

# Prefijos de las reglas escritas en SPARQL
f:prefijos
    sh:declare [ sh:prefix "rdf" ;  sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
               [ sh:prefix "owl" ;  sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] .

# Un individuo no puede ser de dos clases disjuntas (por ejemplo, lugar y actividad), ni directamente
# ni a través de sus superclases
f:Disjuntas
    a sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    sh:sparql [
        sh:prefixes f:prefijos ;
        sh:message "Es a la vez {?una} y {?otra}, que la ontología declara disjuntas (owl:disjointWith)."@es ;
        sh:select """
            SELECT DISTINCT $this ?una ?otra WHERE {
                $this rdf:type/rdfs:subClassOf* ?claseUna ;
                      rdf:type/rdfs:subClassOf* ?claseOtra .
                ?claseUna owl:disjointWith ?claseOtra .
                BIND(REPLACE(STR(?claseUna), "^.*#", "t:") AS ?una)
                BIND(REPLACE(STR(?claseOtra), "^.*#", "t:") AS ?otra)
            }"""
    ] .

# Una propiedad funcional admite un solo valor. Varias ya tienen su sh:maxCount más arriba, con un mensaje
# propio; esta regla cubre además las que se declaren funcionales en adelante.
f:Funcionales
    a sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    sh:sparql [
        sh:prefixes f:prefijos ;
        sh:message "Tiene dos valores distintos de {?propiedad}, que la ontología declara funcional (un solo valor)."@es ;
        sh:select """
            SELECT DISTINCT $this ?path ?propiedad WHERE {
                ?path rdf:type owl:FunctionalProperty .
                $this ?path ?uno , ?otro .
                FILTER(?uno != ?otro)
                BIND(REPLACE(STR(?path), "^.*#", "t:") AS ?propiedad)
            }"""
    ] .

# Quien usa una propiedad debe ser de su dominio (una clase, o alguna de las de una unión): t:tieneModelo3D es
# solo de los lugares, t:Latitud de lugares, ciudades y comunas… Usada en otra cosa, un razonador la
# clasificaría en esa clase, y con las clases disjuntas eso es una contradicción.
f:Dominio
    a sh:NodeShape ;
    sh:targetClass owl:NamedIndividual ;
    sh:sparql [
        sh:prefixes f:prefijos ;
        sh:message "Usa {?propiedad}, pero no es de ninguna clase de su dominio (rdfs:domain)."@es ;
        sh:select """
            SELECT DISTINCT $this ?path ?propiedad WHERE {
                $this ?path ?valor .
                ?path rdfs:domain ?dominio .
                FILTER NOT EXISTS {
                    { ?path rdfs:domain ?clase . FILTER(isIRI(?clase)) }
                    UNION
                    { ?path rdfs:domain/owl:unionOf/rdf:rest*/rdf:first ?clase }
                    $this rdf:type/rdfs:subClassOf* ?clase .
                }
                BIND(REPLACE(STR(?path), "^.*#", "t:") AS ?propiedad)
            }"""
    ] .

# ---------- Datos enlazados

# Si dos individuos apuntan a la misma entidad, owl:sameAs los vuelve el mismo individuo
f:Equivalencia
    a sh:NodeShape ;
    sh:targetObjectsOf owl:sameAs ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path [ sh:inversePath owl:sameAs ] ;
        sh:maxCount 1 ;
        sh:message "Esta entidad externa está enlazada con más de un individuo: owl:sameAs los convertiría en el mismo."@es
    ] .

# El sitio escribe estos IRIs como enlaces: solo se admiten direcciones web
f:EquivalenciaWeb
    a sh:NodeShape ;
    sh:targetObjectsOf owl:sameAs ;
    sh:pattern "^https?://" ;
    sh:message "owl:sameAs debe apuntar a una dirección http(s): el sitio lo muestra como enlace."@es .
